          {
            "type": "command",
            "command": "node \"C:/dev/orc/.claude/hooks/orc-effort-guard.js\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"C:/dev/orc/.claude/hooks/orc-trace.js\""
          }
